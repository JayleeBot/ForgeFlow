# ForgeFlow environment variables
# Do not commit real tokens, secrets, or passwords to GitHub.

# --- Outlook / Microsoft Graph ---
# Access token obtained via Microsoft Graph OAuth flow
FORGEFLOW_OUTLOOK_ACCESS_TOKEN=

# The Outlook mailbox to read from (use test mailbox for development)
FORGEFLOW_OUTLOOK_MAILBOX=forgeflow.demo@outlook.com

# Optional: which folder to read (default: Inbox)
FORGEFLOW_OUTLOOK_FOLDER=Inbox

# Optional: how many messages to pull per sync (default: 25)
FORGEFLOW_OUTLOOK_TOP=25

# --- Azure App Registration ---
# From Azure portal > App Registration > Overview
FORGEFLOW_AZURE_CLIENT_ID=
FORGEFLOW_AZURE_TENANT_ID=
# From Azure portal > App Registration > Certificates & secrets
FORGEFLOW_AZURE_CLIENT_SECRET=
